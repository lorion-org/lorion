{
  "name": "@lorion-org/workspace",
  "private": true,
  "type": "module",
  "version": "1.0.0-beta.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "turbo run build --filter=./packages/*",
    "clean": "turbo run clean --force",
    "dev": "turbo run dev --parallel",
    "example:react-runtime": "pnpm --filter @lorion-examples/react-runtime dev",
    "example:react-loader": "pnpm --filter @lorion-examples/react-loader dev",
    "example:nuxt": "pnpm --filter @lorion-examples/nuxt dev",
    "eslint": "pnpm run lint",
    "eslint:fix": "pnpm run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint --filter=./packages/*",
    "lint:fix": "turbo run lint --filter=./packages/* -- --fix",
    "prettier": "pnpm run format:check",
    "prettier:fix": "pnpm run format",
    "test": "turbo run test",
    "tests": "pnpm run test",
    "tsc": "pnpm run typecheck",
    "typecheck": "turbo run typecheck --filter=./packages/*",
    "check": "pnpm format:check && pnpm build && pnpm lint && pnpm test && pnpm typecheck && pnpm snippets:check && pnpm examples:verify && pnpm package:check && pnpm attw",
    "snippets:check": "tsc -p tsconfig.snippets.json",
    "examples:verify": "turbo run typecheck build lint --filter=./examples/*",
    "package:check": "turbo run package:check --filter=./packages/*",
    "attw": "attw --pack packages/capability-composition --profile node16 && attw --pack packages/composition-graph --profile node16 && attw --pack packages/descriptor-discovery --profile node16 && attw --pack packages/descriptor-selection --profile node16 && attw --pack packages/provider-selection --profile node16 && attw --pack packages/react --profile node16 && attw --pack packages/registry-hub --profile node16 && attw --pack packages/runtime-config --profile node16 && attw --pack packages/runtime-config-node --profile node16 && attw --pack packages/surface-activation --profile node16 && attw --pack packages/nuxt --profile esm-only",
    "publish:check": "pnpm package:check",
    "changeset": "changeset",
    "release:status": "changeset status --verbose",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "release:beta": "changeset publish --tag beta"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.29.6",
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.17",
    "@vitest/coverage-v8": "^3.1.3",
    "eslint": "^9.26.0",
    "eslint-plugin-n": "^17.18.0",
    "prettier": "^3.6.2",
    "publint": "^0.3.18",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.1.3",
    "vue-tsc": "^3.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lorion-org/lorion.git"
  },
  "homepage": "https://github.com/lorion-org/lorion#readme",
  "bugs": {
    "url": "https://github.com/lorion-org/lorion/issues"
  },
  "pnpm": {
    "overrides": {
      "srvx": "0.11.15"
    }
  }
}
