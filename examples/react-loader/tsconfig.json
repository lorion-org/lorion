{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    "noEmit": true,
    "rootDir": "../..",
    "paths": {
      "@lorion-org/capability-composition": ["../../packages/capability-composition/src/index.ts"],
      "@lorion-org/composition-graph": ["../../packages/composition-graph/src/index.ts"],
      "@lorion-org/descriptor-discovery": ["../../packages/descriptor-discovery/src/index.ts"],
      "@lorion-org/react": ["../../packages/react/src/index.ts"],
      "@lorion-org/surface-activation": ["../../packages/surface-activation/src/index.ts"],
      "@acme/plugin": ["./src/plugin.ts"],
      "@acme/payments": ["./capabilities/payments/src/index.ts"],
      "@acme/shops": ["./capabilities/shops/src/index.ts"],
      "@acme/*/web": ["./capabilities/*/src/web.ts", "./external/capabilities/*/src/web.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "capabilities/**/*.ts",
    "capabilities/**/*.tsx",
    "external/**/*.ts",
    "external/**/*.tsx"
  ]
}
