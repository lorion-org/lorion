{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lorion.dev/schemas/descriptor.schema.json",
  "$ref": "#/$defs/descriptor",
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(\\^|~)?\\d+\\.\\d+\\.\\d+$"
    },
    "dependencyMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/semver"
      }
    },
    "descriptor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "providesFor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "$ref": "#/$defs/dependencyMap"
        },
        "disabled": {
          "type": "boolean"
        },
        "location": {
          "type": "string"
        },
        "defaultFor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "providerPreferences": false,
        "bundles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/descriptor"
          }
        },
        "runtimeConfig": {
          "oneOf": [
            {
              "$ref": "#/$defs/runtimeConfigValidationMode"
            },
            {
              "type": "object",
              "properties": {
                "validation": {
                  "$ref": "#/$defs/runtimeConfigValidationMode"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "publicRuntimeConfig": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["id", "version"],
      "additionalProperties": true
    },
    "runtimeConfigValidationMode": {
      "type": "string",
      "enum": ["none", "optional", "startup", "onUse"]
    }
  }
}
